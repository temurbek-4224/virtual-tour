# =============================================================
# Virtual Travel Platform — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ---------------- Database ----------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/virtual_travel_db"

# ---------------- NextAuth.js ----------------
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"

# The canonical URL of your deployment (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ---------------- Google OAuth ----------------
# Get these from https://console.cloud.google.com/
# OAuth 2.0 → Credentials → Create OAuth client ID
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------- Admin Setup ----------------
# Email of the user who should have ADMIN role after seeding
# This email must match the Google account used to log in
ADMIN_EMAIL="your-admin-email@gmail.com"
